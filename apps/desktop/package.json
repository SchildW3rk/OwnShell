{
  "name": "ownshell-desktop",
  "version": "1.23.2",
  "description": "OwnShell - Modern SSH Client for Desktop",
  "homepage": "https://ownshell.app",
  "main": "dist-electron/main.js",
  "author": "OwnShell Contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite --host",
    "dev:electron": "npm run build:worker -- --dev && ELECTRON_DISABLE_SECURITY_WARNINGS=true vite",
    "build": "npm run build:vite && npm run build:mac",
    "build:vite": "npm run build --workspace=@ownshell/core && npm run clean:build && tsc --noEmit && npm run build:worker && vite build",
    "build:worker": "node scripts/build-worker.cjs",
    "build:mac": "electron-builder --mac --arm64 --config electron-builder.json",
    "release:local": "bash scripts/release-local.sh",
    "release:verify": "bash scripts/verify-macos-release.sh",
    "preview": "vite preview",
    "test": "node scripts/run-tests.cjs",
    "test:security": "npm test",
    "perf:prepare": "npm run build --workspace=@ownshell/ui && npm run build:vite",
    "perf:baseline": "node scripts/performance/run.cjs",
    "perf:smoke": "node scripts/performance/run.cjs --profile everyday --smoke",
    "clean:build": "rm -rf dist dist-electron",
    "clean": "rm -rf dist dist-electron release",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint electron src"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1054.0",
    "@aws-sdk/s3-request-presigner": "3.1054.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/state": "^6.5.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.13",
    "@tanstack/react-query": "5.72.2",
    "@tanstack/react-virtual": "^3.13.18",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "6.0.0",
    "better-sqlite3": "12.10.0",
    "codemirror": "^6.0.2",
    "electron-log": "5.3.0",
    "electron-updater": "^6.7.3",
    "i18next": "25.2.1",
    "i18next-browser-languagedetector": "8.0.4",
    "ioredis": "^5.9.2",
    "kysely": "0.28.17",
    "lucide-react": "0.469.0",
    "mongodb": "^7.1.0",
    "mysql2": "^3.17.0",
    "node-pty": "1.1.0",
    "pg": "^8.18.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hot-toast": "2.5.2",
    "react-i18next": "15.4.1",
    "react-is": "^19.2.4",
    "react-resizable-panels": "^4.6.3",
    "recharts": "^3.7.0",
    "ssh2": "1.16.0",
    "uuid": "11.1.1",
    "zod": "3.23.6",
    "zustand": "5.0.5"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@ownshell/config": "*",
    "@ownshell/core": "*",
    "@ownshell/theme": "*",
    "@ownshell/ui": "*",
    "@tailwindcss/vite": "4.1.7",
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.15.3",
    "@types/pg": "^8.16.0",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "@types/ssh2": "1.15.1",
    "@vitejs/plugin-react": "4.5.1",
    "electron-builder": "26.8.1",
    "esbuild": "0.25.12",
    "playwright-core": "^1.58.2",
    "plist": "3.1.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "4.1.7",
    "typescript": "5.8.3",
    "vite": "6.4.2",
    "vite-plugin-electron": "0.29.0",
    "vite-plugin-electron-renderer": "0.14.6"
  }
}
