<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for Electron/Chromium JIT under hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    
    <!-- Network access (required for SSH, SFTP, database, and API client connections) -->
    <key>com.apple.security.network.client</key>
    <true/>
    
    <!-- Dialog-scoped file access for imports, exports, SFTP uploads/downloads, and SQLite files. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
