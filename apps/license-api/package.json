{
  "name": "ownshell-license-api",
  "version": "1.0.0",
  "private": true,
  "description": "OwnShell license entitlement API for Cloudflare Workers",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy:check": "node scripts/deploy-check.mjs",
    "deploy": "wrangler deploy",
    "generate:keys": "node scripts/generate-keys.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260617.1",
    "typescript": "5.8.3",
    "wrangler": "4.101.0"
  }
}
