{
  "name": "ownshell",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@10.2.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "release:desktop": "npm run release:local --workspace=ownshell-desktop",
    "deploy:landing": "npm run deploy --workspace=landing",
    "docs:dev": "npm run dev --prefix docs",
    "docs:build": "npm run build --prefix docs",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "9.24.0",
    "electron": "40.10.1",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.0.0",
    "prettier": "3.5.3",
    "turbo": "2.9.15",
    "typescript": "5.8.3",
    "typescript-eslint": "8.29.1"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  }
}
